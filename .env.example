# Copy this file to .env and change the passwords if you like.
# On Linux, set this to the output of `id -u` so log files are owned by you
AIRFLOW_UID=50000

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me-to-any-random-string

# MySQL staging
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=flight_staging
MYSQL_USER=staging_user
MYSQL_PASSWORD=staging_pass

# PostgreSQL analytics
PG_USER=analytics_user
PG_PASSWORD=analytics_pass
PG_DATABASE=flight_analytics
